{
  "name": "earthtrend-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D Earth observation and environmental trend detection platform powered by public NASA Earth science data.",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-cesium.mjs",
    "geo": "node scripts/fetch-geo.mjs",
    "geo:fast": "node scripts/fetch-geo.mjs --no-adm2",
    "verify:geo": "node scripts/verify-geo.mjs",
    "build": "node scripts/copy-cesium.mjs && node scripts/fetch-geo.mjs && tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "cesium": "^1.147.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
